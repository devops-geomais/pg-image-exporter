DB_HOST=ip_db
DB_PORT=5432
DB_NAME=nome_db
DB_USER=user_db
DB_PASSWORD=passwd_db

DB_QUERIES_FILE=queries.json

OUTPUT_MODE=file

OUTPUT_DIR=output
CHECKPOINT_DIR=checkpoint
FETCH_SIZE=100
#Ambiente	FETCH_SIZE
#HDD	    500
#SSD	    1000
#NVMe	    5000

# Default por job
DEFAULT_BUCKET=nome_bucket
DEFAULT_PREFIX=fotos/
DEFAULT_COMPRESSION=false
DEFAULT_PARALLELISM=4

# MinIO
MINIO_ENDPOINT=ip_minio_s3:9000
MINIO_ACCESS_KEY=acess_key_minio
MINIO_SECRET_KEY=secret_key_minio
MINIO_SECURE=false
MINIO_DT_CRIACAO_TAG=x-amz-meta-dt-criacao

# Configurações de Notificação (ntfy)
NTFY_URL=https://ntfy.geomais.com.br/exportacao_imagens
NTFY_TITLE=PG Image Exporter - nome_bucket
NTFY_PRIORITY=default
NTFY_TAGS=floppy_disk

# -----------------------------------------------------------------------------
# Queries customizadas (formato JSON)
# Cada query deve retornar exatamente 3 colunas:
#
#   1 → coluna BYTEA  (DB_BYTEA_COLUMN)
#   2 → nome do arquivo (DB_NAME_COLUMN)
#   3 → dt_foto data em que a foto foi criada (DB_DT_FOTO_COLUMN)
#
# IMPORTANTE:
# - deve estar em formato JSON válido
# - cada item entre aspas duplas
# - separado por vírgula
# - manter ORDER BY estável (checkpoints dependem disso)
# -----------------------------------------------------------------------------
